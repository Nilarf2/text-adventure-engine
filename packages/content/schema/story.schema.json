{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-adventure-engine.local/schema/story-1.json",
  "title": "Text Adventure Story",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "start", "nodes"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "start": { "type": "string", "minLength": 1 },
    "locale": { "type": "string" },
    "variables": { "type": "object", "additionalProperties": { "$ref": "#/$defs/variable" } },
    "characters": { "type": "object", "additionalProperties": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "portrait": { "type": "string" }, "expressions": { "type": "object", "additionalProperties": { "type": "string" } } } } },
    "assets": { "type": "object", "additionalProperties": { "type": "object", "required": ["src", "type"], "properties": { "src": { "type": "string" }, "type": { "enum": ["image", "audio", "other"] }, "version": { "type": "string" } } } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "variable": { "type": "object", "required": ["type", "default"], "properties": { "type": { "enum": ["string", "number", "boolean"] }, "default": {} } },
    "expression": { "oneOf": [{ "type": ["string", "number", "boolean"] }, { "type": "object", "required": ["var"], "properties": { "var": { "type": "string" } }, "additionalProperties": false }, { "type": "object", "required": ["random"], "properties": { "random": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }, "additionalProperties": false } }, "additionalProperties": false }] },
    "condition": { "oneOf": [{ "type": "object", "required": ["op", "left", "right"], "properties": { "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte"] }, "left": { "$ref": "#/$defs/expression" }, "right": { "$ref": "#/$defs/expression" } } }, { "type": "object", "required": ["op", "conditions"], "properties": { "op": { "enum": ["and", "or"] }, "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } }, { "type": "object", "required": ["op", "condition"], "properties": { "op": { "const": "not" }, "condition": { "$ref": "#/$defs/condition" } } }, { "type": "object", "required": ["op", "tag"], "properties": { "op": { "const": "tag" }, "tag": { "type": "string" } } }, { "type": "object", "required": ["op", "node"], "properties": { "op": { "const": "visited" }, "node": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } } }, { "type": "object", "required": ["op"], "properties": { "op": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9_.-]+$" }, "data": {} }, "additionalProperties": false }] },
    "action": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } }, "additionalProperties": true },
    "node": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "onEnter": { "type": "array", "items": { "$ref": "#/$defs/action" } }, "lines": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "speaker": { "type": "string" }, "expression": { "type": "string" }, "voice": { "type": "string" } }, "additionalProperties": false } }, "next": { "type": "string" }, "prompt": { "type": "string" }, "options": { "type": "array", "items": { "type": "object", "required": ["id", "text", "next"], "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "next": { "type": "string" }, "when": { "$ref": "#/$defs/condition" }, "disabledWhen": { "$ref": "#/$defs/condition" }, "disabledReason": { "type": "string" }, "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } } } } }, "branches": { "type": "array", "items": { "type": "object", "required": ["when", "next"], "properties": { "when": { "$ref": "#/$defs/condition" }, "next": { "type": "string" } } } }, "fallback": { "type": "string" }, "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }, "scene": { "type": "string" }, "background": { "type": "string" }, "music": { "type": "string" }, "ambience": { "type": "string" }, "module": { "type": "string" }, "input": {}, "outcomes": { "type": "object", "additionalProperties": { "type": "string" } }, "resultVariable": { "type": "string" }, "ending": { "type": "string" }, "text": { "type": "string" } }, "additionalProperties": true }
  }
}
